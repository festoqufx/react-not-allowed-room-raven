# Leave empty in local development to use the Vite proxy (recommended).
# Vercel / production: set this in Project Settings → Environment Variables, then redeploy.
# Aliases: BACKEND_ORIGIN or VITE_API_URL
VITE_BACKEND_URL=

# Optional TURN servers for WebRTC behind strict NATs (comma-separated URLs).
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
