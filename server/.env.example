PORT=9000

# Set to 1 when the API runs behind one trusted reverse proxy
TRUST_PROXY=0

# pglite = embedded local Postgres (works without installing PostgreSQL)
# postgres = external PostgreSQL
DB_DRIVER=pglite

DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432
DB_HOST=localhost
DB_NAME=notallowedroom

# Browser URL used in verification links (no trailing slash)
FRONTEND_URL=http://localhost:5173
FRONT_CORS=http://localhost:5173,http://127.0.0.1:5173

# Gmail credentials (APP_PASSWORD must be a Google app password)
APP_GMAIL=your-account@gmail.com
APP_PASSWORD=your-google-app-password
MAIL_FROM="NotAllowedRoom <your-account@gmail.com>"

# Optional generic SMTP alternative to Gmail
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
